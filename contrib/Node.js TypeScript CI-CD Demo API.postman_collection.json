              "name": "Register User",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status code is 201', () => {",
                      "    pm.response.to.have.status(201);",
                      "});",
                      "",
                      "pm.test('Response contains user data without password', () => {",
                      "    const jsonData = pm.response.json();",
                      "    pm.expect(jsonData.statusCode).to.eql(201);",
                      "    pm.expect(jsonData.message).to.include('User created successfully');",
                      "    pm.expect(jsonData.data).to.have.property('id');",
                      "    pm.expect(jsonData.data).to.have.property('name');",
                      "    pm.expect(jsonData.data).to.have.property('email');",
                      "    pm.expect(jsonData.data).to.not.have.property('password');",
                      "});",
                      "",
                      "if (pm.response.json().data && pm.response.json().data.id) {",
                      "    pm.collectionVariables.set('userId', pm.response.json().data.id);",
                      "}"
