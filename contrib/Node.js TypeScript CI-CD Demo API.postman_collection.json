    "_postman_id": "c59e05f2-ca4e-487c-80b6-baf2ab66ef91",
    "name": "Node.js TypeScript CI/CD Demo API",
    "description": "Complete API test collection for Node.js TypeScript application with JWT authentication, PostgreSQL, and Redis\n\n## API Versioning\n\nThis API uses versioning with the prefix `/v1`. All endpoints are accessible under:\n- `{{baseUrl}}/api/v1/`\n- Legacy support: `{{baseUrl}}/api/` (redirects to v1)\n\n## Authentication\n\n1. Use `POST {{baseUrl}}/api/v1/auth/login` to login\n2. Copy the access token from response\n3. Set `accessToken` variable using the pre-request script or manually",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "18974135"
  },
  "item": [
    {
      "name": "Health & Root",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 503', () => {",
                  "    pm.response.to.have.status(200) || pm.response.to.have.status(503);",
                  "});",
                  "",
                  "pm.test('Response has expected structure', () => {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('statusCode');",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "});",
                  "",
                  "pm.test('Health data contains status field', () => {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.data) {",
                  "        pm.expect(jsonData.data).to.have.property('status');",
                  "        pm.expect(jsonData.data).to.have.property('environment');",
                  "        pm.expect(jsonData.data).to.have.property('database');",
                  "        pm.expect(jsonData.data).to.have.property('redis');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        },
